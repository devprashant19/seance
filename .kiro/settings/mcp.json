{
  "mcpServers": {
    "seance": {
      "command": "node",
      "args": ["packages/seance-mcp/dist/index.js"],
      "env": {
        "SEANCE_RELAY_URL": "ws://localhost:8787",
        "SEANCE_ROOM": "DEV1",
        "SEANCE_OBSERVER_KEY": "dev-only-not-a-secret"
      },
      "disabled": true,
      "autoApprove": ["list_spirits", "trace_stats"]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "disabled": false
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "disabled": true
    }
  }
}
