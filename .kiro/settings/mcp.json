{
  "mcpServers": {
    "seance": {
      "command": "node",
      "args": [
        "packages/seance-mcp/dist/index.js"
      ],
      "env": {
        "SEANCE_RELAY_URL": "ws://localhost:4000",
        "SEANCE_ROOM": "DEV1",
        "SEANCE_OBSERVER_KEY": "dev-only-not-a-secret"
      },
      "disabled": false,
      "autoApprove": [
        "list_spirits",
        "trace_stats",
        "read_stream",
        "run_experiment",
        "compare_traces"
      ]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "disabled": false
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "disabled": true
    }
  }
}
